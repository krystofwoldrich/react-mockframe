{
  "name": "device-frames-monorepo",
  "author": {
    "name": "Krystof Woldrich",
    "url": "https://github.com/krystofwoldrich"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/krystofwoldrich/react-mockframe"
  },
  "bugs": {
    "url": "https://github.com/krystofwoldrich/react-mockframe/issues"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:lib dev:site",
    "dev:lib": "pnpm --filter @krystofs/device-frames dev",
    "dev:site": "pnpm --filter device-frames-example dev",
    "build": "pnpm build:lib && pnpm build:site",
    "build:lib": "pnpm --filter @krystofs/device-frames build",
    "build:site": "pnpm --filter device-frames-example build",
    "preview": "pnpm --filter device-frames-example preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@krystofs/device-frames": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
