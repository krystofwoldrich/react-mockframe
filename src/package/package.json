{
  "name": "@krystofs/device-frames",
  "version": "1.0.0",
  "author": {
    "name": "Krystof Woldrich",
    "url": "https://github.com/krystofwoldrich"
  },
  "contributors": [
    {
      "name": "Mohammed Banani",
      "url": "https://github.com/mbdev3"
    }
  ],
  "description": "React device frames with real screen and body shapes: iPhone, iPhone Duo, Pixel, Pixel Fold, Galaxy, iPad and MacBook mockups for landing pages and product showcases. A fork of react-mockframe.",
  "keywords": [
    "react",
    "device",
    "mockframe",
    "mockup",
    "phone",
    "tablet",
    "laptop",
    "iphone",
    "ipad",
    "macbook",
    "pixel",
    "galaxy",
    "frame",
    "screenshot",
    "component",
    "typescript",
    "landing-page",
    "saas",
    "product-showcase",
    "marketing",
    "hero-section",
    "app-preview",
    "ui-showcase",
    "device-frame",
    "superellipse",
    "foldable",
    "pixel-fold",
    "iphone-duo",
    "react-mockframe"
  ],
  "homepage": "https://github.com/krystofwoldrich/react-mockframe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krystofwoldrich/react-mockframe.git",
    "directory": "src/package"
  },
  "bugs": {
    "url": "https://github.com/krystofwoldrich/react-mockframe/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "dist/styles/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles/mockframe.css": "./dist/styles/mockframe.min.css",
    "./styles/mockframe-iphones.css": "./dist/styles/mockframe-iphones.min.css",
    "./styles/mockframe-android.css": "./dist/styles/mockframe-android.min.css",
    "./styles/mockframe-tablets.css": "./dist/styles/mockframe-tablets.min.css",
    "./styles/mockframe-laptops.css": "./dist/styles/mockframe-laptops.min.css",
    "./package.json": "./package.json",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:ts dev:css",
    "dev:ts": "tsup src/index.ts --format cjs,esm --dts --watch",
    "dev:css": "node scripts/watch-css.js",
    "build": "pnpm build:ts && pnpm build:css && node scripts/gen-readme.js",
    "build:ts": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:css": "node scripts/build-css.js && node scripts/build-css-modules.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "chokidar": "^4.0.3",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.2.3",
    "tsup": "^8.3.5",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
